# toss-invest-mcp 설정 예시. 복사 후 chmod 600 으로 보관하세요.

# 토스증권 Open API (필수)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# TOSS_ACCOUNT_SEQ=

# 주문 안전장치
TRADING_MODE=dry_run          # off | dry_run | live
# 매수 한도 (비워두면 무제한, 매도는 한도 대상 아님)
# MAX_ORDER_USD=1000
# MAX_ORDER_KRW=1500000
# DAILY_MAX_USD=3000
# DAILY_MAX_KRW=4500000
# DAILY_MAX_ORDERS=10
# ALLOWED_SYMBOLS=AAPL,TSLA,005930
# NTFY_TOPIC=                 # 설정하면 폰 확인코드 필수 (추측 못 하게 길게)

# HTTP 모드 전용
# MCP_PATH_SECRET=            # toss-invest-mcp gen-secret
# MCP_AUTH_TOKEN=
# PUBLIC_HOST=mcp.example.com
# LISTEN_HOST=127.0.0.1
# LISTEN_PORT=8000

# DATA_DIR=~/.local/state/toss-invest-mcp
